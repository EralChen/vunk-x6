{
  "name": "vunk-x6",
  "description": "基于 [x6](https://x6.antv.antgroup.com/) 的 Vue3 组件库, 基于业务二次封装。",
  "scripts": {
    "dev": "pnpm run -C docs dev",
    "server:dev": "pnpm run -C server dev",
    "lint:fix": "oxlint . --fix",
    "lint": "eslint --fix app-ssr/**/*.{ts,tsx,vue}",
    "build": "pnpm run -C app build",
    "lib:build": "gulp -f scripts/build/index.ts",
    "stub": "pnpm run -r --parallel stub",
    "postinstall": "pnpm stub",
    "docs:dev": "pnpm run -C docs dev",
    "docs:build": "pnpm run -C docs build",
    "docs:init-arcgis": "gulp -f scripts/docs/init-arcgis.ts",

    "publish": "gulp -f scripts/publish.ts",
    "docker:publish": "gulp -f scripts/docker/publish.ts",
    "cc": "gulp -f scripts/create/component/index.ts",
    "ccd": "gulp -f scripts/create/component-docs/index.ts",
    "app:preview": "gulp -f scripts/app/preview.ts",

    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:pull": "prisma db pull",
    "prisma:reset": "prisma migrate reset",
    "prisma:dev": "prisma migrate dev --name init",
    "prisma:ppg": "npx @prisma/ppg-tunnel --port 5432",

    "run:task": "gulp -f scripts/task.ts",
    "rm:nm": "find . -name \"node_modules\" -type d -prune -exec rm -rf '{}' +"
  },
  "dependencies": {
    "@antv/x6": "^2.18.1",
    "@antv/x6-plugin-dnd": "^2.1.1",
    "@antv/x6-plugin-selection": "^2.2.2",
    "@antv/x6-vue-shape": "^2.1.2",
    "@element-plus/icons-vue": "^2.3.1",
    "@prisma/client": "6.5.0",
    "@prisma/extension-accelerate": "1.2.2",
    "@skzz/platform": "0.0.0-alpha.73",
    "@vueuse/core": "^11.3.0",
    "@vunk-x6/components": "workspace:*",
    "@vunk-x6/composables": "workspace:*",
    "@vunk-x6/icons": "workspace:*",
    "@vunk-x6/shared": "workspace:*",
    "@vunk/core": "1.4.0",
    "@vunk/form": "2.8.0",
    "@vunk/plus": "1.2.0",
    "@vunk/server": "^0.2.3",
    "@vunk/shared": "0.5.56",
    "@vunk/skzz": "0.0.0-alpha.111",
    "@vunk/x6": "workspace:*",
    "deepdash-es": "^5.3.9",
    "element-plus": "^2.9.7",
    "koa": "^2.16.1",
    "three": "^0.170.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.12.0",
    "@lib-env/build-constants": "workspace:*",
    "@lib-env/build-utils": "workspace:*",
    "@lib-env/path": "workspace:*",
    "@types/gulp": "^4.0.17",
    "@types/node": "18.0.4",
    "@types/three": "^0.165.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitejs/plugin-vue-jsx": "^4.1.2",
    "@vue/compiler-sfc": "^3.5.13",
    "comment-parser": "^1.4.1",
    "eslint": "^9.24.0",
    "eslint-plugin-oxlint": "^0.16.5",
    "fast-glob": "^3.3.2",
    "gulp": "^5.0.0",
    "gulp-concat": "^2.6.1",
    "mri": "^1.2.0",
    "openai": "^4.85.4",
    "oxlint": "^0.16.5",
    "pinia": "^2.2.6",
    "pinia-plugin-persist": "^1.0.0",
    "rollup": "^4.27.3",
    "sass": "^1.81.0",
    "sucrase": "^3.35.0",
    "tsx": "^4.19.2",
    "unbuild": "^3.5.0",
    "unocss": "^66.1.0-beta.11",
    "unocss-preset-vunk": "^1.0.4",
    "unplugin-oxlint": "^0.7.4",
    "unplugin-vue-markdown": "^28.3.1",
    "vike": "0.4.227",
    "vike-vue": "0.9.0",
    "vite": "^6.2.3",
    "vite-plugin-external": "^4.3.1",
    "vite-plugin-vue-devtools": "^7.6.4",
    "vitest": "^2.1.5"
  }
}
